{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/build.mjs",
    "scripts/prepare-assets.mjs",
    "scripts/verify-source.mjs",
    "scripts/run-baseline.mjs",
    "tests/*.test.mjs",
    "scripts/adapt-web.mjs",
    "server/*.mjs"
  ]
}
