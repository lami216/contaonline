# Runtime service is introduced in phase 3. Never put secrets here.
HOST=127.0.0.1
PORT=4318
NODE_ENV=development
STAGING_ACCESS_KEY_FILE=/absolute/private/staging-access.json
SERVICE_CONFIG_FILE=/absolute/private/service/config.json
SERVICE_PRIVATE_DIR=/absolute/private/service
DATA_DIRECTORY=/var/lib/contaonline
PRIVATE_BACKUP_DIRECTORY=/var/lib/contaonline/backups
