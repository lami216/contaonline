# Private review only. Set these in the process environment; never put secrets here.
# Host is deliberately fixed to 127.0.0.1; production startup is refused.
PORT=4318
NODE_ENV=development
STAGING_ACCESS_KEY_FILE=/absolute/private/staging-access.json
SERVICE_CONFIG_FILE=/absolute/private/service/config.json
SERVICE_PRIVATE_DIR=/absolute/private/service
# Database and private content paths are in the private SERVICE_CONFIG_FILE.
# Optional CLI recovery/archive inputs:
ADMIN_RECOVERY_CODE_FILE=/absolute/private/admin-recovery-code.txt
SERVER_BACKUP_KEY_FILE=/absolute/private/server-archive.key
