{
  "name": "contaonline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "test:baseline": "node scripts/run-baseline.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint scripts/*.mjs tests/*.mjs server/*.mjs shared/*.mjs web/*.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run verify:source && npm run prepare:assets && npm run lint && npm run typecheck && npm run test:baseline && npm run build && npm test",
    "build": "node scripts/build.mjs",
    "start:review": "node server/start.mjs",
    "staging:key": "node scripts/staging-key.mjs",
    "service:init": "node scripts/service-admin.mjs init",
    "migrate": "node scripts/service-admin.mjs migrate",
    "bootstrap-admin": "node scripts/service-admin.mjs init",
    "recover-admin": "node scripts/service-admin.mjs recover-admin",
    "test:e2e": "node e2e/pwa.mjs && node e2e/service.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "jspdf": "4.2.1",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
